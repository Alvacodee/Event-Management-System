# Connection string database PostgreSQL
# lokal: postgresql://user:password@localhost:5432/ieee_event_dev
# Neon/Supabase: minta connection string dari dashboard masing-masing
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# String random untuk sign JWT admin, generate sendiri contoh: openssl rand -base64 32
JWT_SECRET="ganti-dengan-random-string-yang-panjang-dan-rahasia"

